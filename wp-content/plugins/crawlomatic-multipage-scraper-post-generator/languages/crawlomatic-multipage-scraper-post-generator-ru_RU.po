"%%royalty_free_image_attribution%%, %%item_url%%, %%item_cat%% , "
"%%current_date%%, %%current_time%%, %%item_tags%%, "
"%%item_content_plain_text%%, %%item_screenshot_url%%, "
"%%item_show_screenshot%%, %%item_read_more_button%%, %%item_show_image%%, "
