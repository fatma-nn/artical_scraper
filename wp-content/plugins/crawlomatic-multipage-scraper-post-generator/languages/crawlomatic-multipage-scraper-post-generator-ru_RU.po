"%%custom_html%%, %%custom_html2%%, %%random_sentence%%, %%random_sentence2%%,"
" %%item_title%%, %%item_description%%, %%item_gallery%%, %%item_content%%, "
"%%item_content_plain_text%%, %%item_screenshot_url%%, "
"%%item_show_screenshot%%, %%item_img_url%%, "
"%%royalty_free_image_attribution%%, %%item_url%%, %%item_cat%%, "
"%%current_date%%, %%current_time%%, %%item_tags%%, %%item_read_more_button%%,"
" %%item_show_image%%, %%item_image_URL%%, %%item_description%%, "
"%%item_gallery%%, %%item_pub_date%%, %%downloaded_file%%. If you defined "
"custom tag names in the \\'Feed Item Custom Tag Names\\' settings field in "
